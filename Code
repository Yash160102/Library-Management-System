        */
        class AdminLogin{
            public:
                /*
                    loginAdmin()
                    ------------
                    Reads admin credentials from admin.bin
                    and compares them with entered credentials.

                    Concept used:
                    - Binary file handling
                    - static data members
                    - strcmp()
                    - while loop
                */
                bool loginAdmin() {
                    
                    /*
                        Continue asking for credentials
                        until correct credentials are entered
                        or admin.bin cannot be opened.
                    */
                    while(true){
                        char inputUsername[30];
                        char inputPassword[30];
                        
                        cout << "Username: ";
                        cin >> inputUsername;
                
                        cout << "Password: ";
                        cin >> inputPassword;
                
                        ifstream file("admin.bin", ios::binary);       // Open admin credentials file
                        try {
                            if (!file) {
                            throw string("No admin credentials found!\n");
                            return false;
                            }
                        }catch(string a){
                            cout<<a;
                        }
                        
                        /*
                            Initialize arrays with zero.

                            This ensures they initially contain
                            null characters.
                        */
                        
                        char storedUsername[30] = {0};
                        char storedPassword[30] = {0};
                
                        file.read(storedUsername, sizeof(storedUsername));           // Read stored username
                        file.read(storedPassword, sizeof(storedPassword));           // Read stored password
                        file.close();
                        /*
                            Compare entered credentials with
                            stored credentials.
                        */
                        if (strcmp(inputUsername, storedUsername) == 0 &&
                            strcmp(inputPassword, storedPassword) == 0) {
                            cout << "Login successful\n";
                            return true;
                        }
                        else {
                            cout << "Invalid credentials!! Enter Again\n";
                        }

                    }
                }
                
                /*
                    addBook()
                    ---------
                    Adds a new book to bookdetails.txt.

                    Concept used:
                    - Object creation
                    - Text file handling
                    - Error Handling
                    - ofstream
                    - ios::app
                    - getline()
                */
                
                void addBook(){
                    Details emp;
                    
                    /*
                        Open bookdetails.txt in append mode.

                        Existing books are not deleted.
                    */
                    
                    ofstream file("bookdetails.txt", ios::app);
                    try {
                        if(!file) {
                        throw string("Error opening book details file!");
                        return;
                        }
                    }catch(string a){
                        cout<<a;
                    }
                    
                    cout<<"Enter Book Id: ";
                    cin>>emp.bid;
                    cout<<"Enter Book Name: ";
                    cin.ignore();
                    getline(cin,emp.bname);
                    cout<<"Enter Book Availability(Yes/No): ";
                    cin>>emp.available;
                    
                    /*
                        Store Book ID, Book Name and
                        Availability in the text file.
                    */
                    
                    file << emp.bid << "\t\t" << emp.bname << "\t\t" << emp.available<<"\n";
                    file.close();
                    cout<<"\n==========Book added successfully!!==========\n";
                    
                    /*
                    Function calling another function.

                    Here addBook() calls adminMenu()
                    after adding the book.

                    This creates a recursive flow because
                    adminMenu() can call addBook() again.
                    */
                    
                    adminMenu();
                }
                
                /*
                    adminMenu()
                    -----------
                    Displays the administrator menu.

                    Concepts used:
                    - Menu-driven programming
                    - if-else
                    - Object creation
                    - Nested class access
                */
                
                void adminMenu(){
                    string a;
                    cout<<"\n";
                    cout<<"1. Add a  Book\n";
                    cout<<"2. View all users\n";
                    cout<<"3. Remove a user\n";
                    cout<<"4. Exit\n";
                    cout<<"Enter a choice: ";
                    cin>>a;
                    if(a=="1"){
                        addBook();
                    }else if(a == "2"){
                        
                        /*
                            Creating an object of the nested
                            UserRegister class.

                            User:: is the scope resolution
                            operator used to access the nested
                            class.
                        */
                        
                        User::UserRegister ur;
                        ur.viewAllUsers();
                    }else if(a == "3"){
                        User::UserLogin ul;                   // Creating an object of UserLogin to access deleteUser().
                        ul.deleteUser();
                    }else if(a=="4"){
                        cout<<"\n==========Returning to main menu ==========\n";
                        return;
                    }
                }
        };
};

